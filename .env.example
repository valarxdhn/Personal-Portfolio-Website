# ==============================================================================
# Portfolio Environment Configuration
# Copy this file to `.env.local` to configure email delivery and production settings.
# ==============================================================================

# Resend API Key (Obtain from https://resend.com/api-keys)
# Required for the interactive contact form to dispatch genuine emails to your inbox.
# When omitted, the contact section automatically displays a direct contact panel
# with working mailto links and copy actions — zero fake success messages.
CONTACT_EMAIL_API_KEY=re_your_api_key_here

# Recipient inbox where contact inquiries will be delivered.
CONTACT_RECIPIENT_EMAIL=dhanushmk95@gmail.com

# Verified sender email address.
# For initial testing on Resend's free tier, you can use:
#   Portfolio Contact <onboarding@resend.dev>
# Note: Onboarding domain can only deliver to the email address registered on your Resend account.
# In production with a custom domain, use:
#   Dhanush Portfolio <contact@yourdomain.com>
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Production Canonical URL
NEXT_PUBLIC_SITE_URL=https://dhanush-portfolio.vercel.app
