# Portfolio Environment Configuration
# Copy this file to .env.local to configure email delivery and production settings.

# (Optional) Email Service API Key (e.g., from Resend: https://resend.com)
# When set, contact submissions are automatically forwarded to CONTACT_RECIPIENT_EMAIL via Resend.
# When omitted, inquiries are durably appended to src/data/inquiries.json on the server.
CONTACT_EMAIL_API_KEY=

# (Optional) Recipient inbox for contact inquiries
CONTACT_RECIPIENT_EMAIL=dhanush.cse.dev@gmail.com

# (Optional) Verified sender email address (required by email delivery provider)
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Production Domain
NEXT_PUBLIC_SITE_URL=https://dhanush-portfolio.vercel.app
